GCP_PROJECT_ID=your-project-id
REGION=europe-west1
PUBSUB_TOPIC=projects/your-project-id/topics/gmail-notifications
# OIDC audience for Pub/Sub push and Cloud Scheduler, and the only accepted caller
SERVICE_URL=https://alza-ai-assistant-xxxx-ew.a.run.app
INVOKER_SERVICE_ACCOUNT=gmail-pubsub-invoker@your-project-id.iam.gserviceaccount.com
# Gemini on Vertex AI; newer models exist only in the global location
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REGION=global

# Attachment limits in MB: per file, per email
MAX_ATTACHMENT_MB=10
MAX_TOTAL_ATTACHMENTS_MB=18

# Gmail OAuth (Secret Manager: gmail-client-id, gmail-client-secret, gmail-oauth-refresh-token)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
