# Copy to .env for local runs (scripts/run_once.py, scripts/run_once_recovery.py).
# In Cloud Run these are environment variables; the GMAIL_* values are secrets.

# --- Required (the app does not start without them) ------------------------------
GCP_PROJECT_ID=your-project-id
GEMINI_MODEL=gemini-3.5-flash-lite
# Vertex AI location of the model; newer models are served only from "global"
GEMINI_REGION=global

# Gmail OAuth of the bot's mailbox
# (Secret Manager: gmail-client-id, gmail-client-secret, gmail-oauth-refresh-token)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# Cloud Run URL that Pub/Sub and Scheduler call: the accepted OIDC token audience
SERVICE_URL=https://alza-ai-assistant-123456789.europe-west1.run.app
# Topic Gmail publishes new-mail notifications to
PUBSUB_TOPIC=projects/your-project-id/topics/gmail-notifications
# The only account allowed to call the endpoints (Pub/Sub push and Scheduler)
INVOKER_SERVICE_ACCOUNT=gmail-pubsub-invoker@your-project-id.iam.gserviceaccount.com
# Knowledge base: RAG Engine corpus, used by every Gemini call
RAG_CORPUS=projects/your-project-id/locations/europe-west4/ragCorpora/your-corpus-id

# --- Optional (defaults shown) ----------------------------------------------------
# MAX_ATTACHMENT_MB=10
# MAX_TOTAL_ATTACHMENTS_MB=18
# RAG_TOP_K=5
# RAG_DISTANCE_THRESHOLD=0.5
# RAG_DEBUG=false
